# Copy this file to .env and fill in real values. Never commit .env itself.

# --- OpenRouter (required) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_MODEL=anthropic/claude-3.5-sonnet
VISION_MODEL=anthropic/claude-3.5-sonnet

# --- Auth (required) ---
JWT_SECRET_KEY=change-this-to-a-long-random-string

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./anqa.db

# --- Vector memory ---
VECTOR_STORE_PATH=./anqa_vector_store
MEMORY_TOP_K=5

# --- Voice (optional — leave blank to disable voice features) ---
STT_API_KEY=
TTS_API_KEY=

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
